{
  "name": "yais-kitchen",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "mock": "npm run mock -w @yais-kitchen/api-spec",
    "gateway": "npm run dev -w @yais-kitchen/gateway",
    "auth": "npm run dev -w @yais-kitchen/auth",
    "notification": "npm run dev -w @yais-kitchen/notification",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0"
  }
}
