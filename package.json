{
  "name": "yais-kitchen",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "services/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint . && prettier --check . && npm run lint --workspaces --if-present",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "setup": "node infra/setup.js",
    "up": "docker compose -f infra/docker-compose.yml up -d --build --wait",
    "down": "docker compose -f infra/docker-compose.yml down",
    "mock": "npm run mock -w @yais-kitchen/api-spec",
    "web": "npm run dev -w @yais-kitchen/web",
    "gateway": "npm run dev -w @yais-kitchen/gateway",
    "auth": "npm run dev -w @yais-kitchen/auth",
    "catalog": "npm run dev -w @yais-kitchen/catalog",
    "notification": "npm run dev -w @yais-kitchen/notification",
    "prepare": "husky",
    "booking": "npm run dev -w @yais-kitchen/booking",
    "payment": "npm run dev -w @yais-kitchen/payment",
    "live-class": "npm run dev -w @yais-kitchen/live-class",
    "test:max": "vitest run services/booking/tests services/payment/tests services/live-class/tests",
    "validate:api": "npm run lint -w @yais-kitchen/api-spec",
    "up:max": "docker compose -f infra/docker-compose.yml -f infra/max.compose.yml up -d --build --wait"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "vitest": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0"
  }
}
