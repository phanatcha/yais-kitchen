# Copy to .env and fill in. Never commit .env.
# Defaults match the local containers in infra/.
NODE_ENV=development
LOG_LEVEL=info
MONGO_URL=mongodb://localhost:27017
RABBITMQ_URL=amqp://localhost:5672
SMTP_HOST=localhost
SMTP_PORT=1025
# Auth's Ed25519 public key in PEM, on one line with \n for line breaks.
# Every service checks tokens with it. packages/shared/README.md says how to make one.
AUTH_PUBLIC_KEY=
# The matching private key, the same way. Only auth signs with it.
# `npm run token -w @yais-kitchen/gateway` also uses it for test tokens.
AUTH_PRIVATE_KEY=
# Shared secret for /internal calls between services, at least 32 characters.
INTERNAL_TOKEN=

# Gateway
WEB_ORIGIN=http://localhost:5173
# Services without a URL below are sent to the mock server.
MOCK_URL=http://127.0.0.1:4010
# AUTH_URL=http://127.0.0.1:3001
# CATALOG_URL=
# BOOKING_URL=
# PAYMENT_URL=
# LIVE_CLASS_URL=
# MEDIA_URL=
UPSTREAM_TIMEOUT_MS=10000
TRUST_PROXY_HOPS=0

# Notification
ADMIN_EMAIL=admin@example.com
# EMAIL_FROM="Yai's Kitchen <hello@yais-kitchen.local>"
# SMTP_USER=
# SMTP_PASSWORD=
REMINDER_CHECK_MS=30000
